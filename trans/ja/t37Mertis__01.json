{
"13": "今日は競売なし。",
"14": "家畜を見てこい。",
"15": "明日はキノコ飯を売るぞ。",
"16": "やあ、兵士さん。",
"17": "ニッコ、だめだ。",
"18": "お腹すいたかい、ハニー？",
"19": "弓が要りますか、戦士さん？",
"20": "投げ槍あるぞ。",
"21": "武器ならあるぞ。",
"22": "まだ鉄が足りない。",
"23": "黒曜石は本当にもろい。",
"24": "はあ。",
"25": "（かき混ぜる。）",
"26": "（すりつぶす。）",
"27": "（トントン。トントン。）",
"28": "エルガーに栄光あれ！",
"29": "悪を叩き潰せ！",
"30": "敵の腸を引きずり出せ。",
"31": "客だ！",
"33": "談話室は空だ。",
"34": "ようこそ、使節殿。",
"35": "通行路を調べているところだ。",
"36": "灰色の通行証が一番いい。",
"37": "赤い通行証は最悪だ。",
"38": "厳重な監房には入るな。",
"39": "仕事があるかもしれん。",
"40": "帝国の捕虜はここに来る。",
"41": "書類が多すぎる。",
"42": "ゴホッ。",
"43": "うえっ。",
"44": "もう耐えられない。",
"45": "迫ってきている。",
"46": "お前には屈しないぞ。",
"47": "黙れ、ゴーブ。",
"48": "痛くしないで！",
"49": "何でも話す。",
"50": "通行路のことなら知っている。"
}
